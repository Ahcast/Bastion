        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "name": {
              "type": "string",
              "maxLength": 180
            },
            "rtn": {
              "type": "string",
              "maxLength": 30
            },
            "email": {
              "type": "string",
              "maxLength": 254
            },
            "country": {
              "type": "string",
              "maxLength": 80
            },
            "website": {
              "type": "string",
              "maxLength": 2048
            },
            "is_active": {
              "type": "boolean"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": [
            "id",
            "name",
            "rtn",
            "email",
            "country",
            "website",
            "is_active",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "page": {
        "type": "integer",
