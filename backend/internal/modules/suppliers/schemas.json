{
  "supplier": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "name": {
        "type": "string",
        "maxLength": 180
      },
      "rtn": {
        "type": "string",
        "maxLength": 30
      },
      "contact_name": {
        "type": "string",
        "maxLength": 120
      },
      "phone": {
        "type": "string",
        "maxLength": 50
      },
      "email": {
        "type": "string",
        "maxLength": 254
      },
      "address": {
        "type": "string",
        "maxLength": 1000
      },
      "team_id": {
        "type": "string"
      },
      "version": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "created_by": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "updated_by": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "is_active": {
        "type": "boolean"
      },
      "contacts": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "role": {
              "type": "string",
              "maxLength": 100
            },
            "phone": {
              "type": "string",
              "maxLength": 50
            },
            "email": {
              "type": "string",
              "maxLength": 254
            }
          },
          "required": [
            "name",
            "role",
            "phone",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "country": {
        "type": "string",
        "maxLength": 80
      },
      "website": {
        "type": "string",
        "maxLength": 2048
      },
      "notes": {
        "type": "string",
        "maxLength": 4000
      },
      "payment_terms": {
        "type": "string",
        "maxLength": 1000
      },
      "lead_time": {
        "type": "string",
        "maxLength": 120
      },
      "evaluation": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 5
      },
      "response_hours": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 8760
      },
      "reliability": {
        "type": "string",
        "enum": [
          "unknown",
          "low",
          "medium",
          "high"
        ]
      },
      "categories": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 80
        }
      },
      "brands": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 80
        }
      },
      "products": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "brand": {
              "type": "string",
              "maxLength": 80
            },
            "part_number": {
              "type": "string",
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "lead_time": {
              "type": "string",
              "maxLength": 120
            },
            "moq": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "brand",
            "part_number",
            "description",
            "lead_time",
            "moq"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "rtn",
      "contact_name",
      "phone",
      "email",
      "address",
      "team_id",
      "version",
      "created_by",
      "updated_by",
      "created_at",
      "updated_at",
      "is_active",
      "contacts",
      "country",
      "website",
      "notes",
      "payment_terms",
      "lead_time",
      "evaluation",
      "response_hours",
      "reliability",
      "categories",
      "brands",
      "products"
