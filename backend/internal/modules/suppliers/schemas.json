  "match": {
    "type": "object",
    "properties": {
      "match": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "supplier_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "supplier_name_snapshot": {
                "type": "string",
                "maxLength": 180
              },
              "supplier_rtn_snapshot": {
                "type": "string",
                "maxLength": 30
              },
              "supplier_contact_snapshot": {
                "type": "string",
                "maxLength": 120
              },
              "supplier_phone_snapshot": {
                "type": "string",
                "maxLength": 50
              },
              "supplier_email_snapshot": {
                "type": "string",
                "maxLength": 254
              },
              "supplier_address_snapshot": {
                "type": "string",
                "maxLength": 1000
              },
              "supplier_country_snapshot": {
                "type": "string",
                "maxLength": 80
              },
              "supplier_website_snapshot": {
                "type": "string",
                "maxLength": 2048
              },
              "supplier_version": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "required": [
              "supplier_id",
              "supplier_name_snapshot",
              "supplier_rtn_snapshot",
              "supplier_contact_snapshot",
              "supplier_phone_snapshot",
              "supplier_email_snapshot",
              "supplier_address_snapshot",
              "supplier_country_snapshot",
              "supplier_website_snapshot",
              "supplier_version"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "match"
    ],
    "additionalProperties": false
  }
