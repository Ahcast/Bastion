      },
      "per_page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "data",
      "total",
      "page",
      "per_page"
    ],
    "additionalProperties": false
  },
  "price_page": {
    "type": "object",
