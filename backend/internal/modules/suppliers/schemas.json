            "source_url": {
              "type": "string",
              "maxLength": 2048
            },
            "source_type": {
              "type": "string",
              "enum": [
                "web",
                "catalog"
              ]
            },
            "source_observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "part_number": {
              "type": "string",
              "maxLength": 80
            },
            "observed_price": {
              "type": "string",
              "maxLength": 64
            },
            "currency": {
              "type": "string",
              "maxLength": 3
            },
            "availability": {
              "type": "string",
              "maxLength": 500
            },
            "lead_time": {
              "type": "string",
              "maxLength": 120
            },
            "moq": {
              "type": "string",
              "maxLength": 64
            },
            "taxes": {
              "type": "string",
              "enum": [
                "unknown",
                "included",
                "excluded"
              ]
            },
            "shipping": {
              "type": "string",
              "enum": [
                "unknown",
                "included",
                "excluded"
              ]
            },
            "user_name": {
              "type": "string",
              "maxLength": 180
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "source_url",
            "source_type",
            "source_observed_at",
            "part_number",
            "observed_price",
            "currency",
            "availability",
            "lead_time",
            "moq",
            "taxes",
            "shipping",
            "user_name",
            "captured_at"
          ],
          "additionalProperties": false
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "page": {
        "type": "integer",
        "minimum": 1
      },
      "per_page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "data",
      "total",
      "page",
      "per_page"
    ],
    "additionalProperties": false
