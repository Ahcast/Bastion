[Unit]
Description=Bastion bounded worker
After=network-online.target
[Service]
Type=oneshot
User=bastion
Group=bastion
WorkingDirectory=/opt/bastion
EnvironmentFile=/etc/bastion/core.env
ExecStart=/opt/bastion/bin/worker
TimeoutStartSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
UMask=0077
