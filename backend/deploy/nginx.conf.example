# Template only: certificates and domain must be configured in an authorized environment.
# These zones are evaluated on the public client IP before traffic is proxied to Go.
limit_req_zone $binary_remote_addr zone=bastion_auth:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=bastion_mcp:10m rate=300r/m;

server {
    listen 443 ssl;
    server_name api.bastion.castilloit.net;
    ssl_certificate /etc/letsencrypt/live/api.bastion.castilloit.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.bastion.castilloit.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    limit_req_status 429;

    location /api/internal/v1/crawler/ {
        client_max_body_size 24m;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 85s;
        proxy_buffering off;
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=bastion_auth burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 35s;
        proxy_buffering off;
    }

    location = /mcp {
        limit_req zone=bastion_mcp burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 35s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 35s;
        proxy_buffering off;
    }
}
