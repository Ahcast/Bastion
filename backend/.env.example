BASTION_ENV=development
BASTION_LISTEN=127.0.0.1:8080
BASTION_FRONTEND_ORIGIN=http://localhost:4200
# MySQL 5.7 test only. Production requires TLS DSN or verified local SSH tunnel.
BASTION_MYSQL_DSN=bastion:change-me@tcp(127.0.0.1:3306)/bastion?parseTime=true&loc=UTC&charset=utf8mb4
BASTION_DB_TUNNEL_VERIFIED=false
# Base64 of 32 random bytes. Never commit real keys.
BASTION_ENCRYPTION_KEY=
BASTION_MCP_ENABLED=false
BASTION_EMAIL_ENABLED=false
BASTION_FILES_ENABLED=false
# Catalog module enabled by default. Changes require server restart; data is preserved.
BASTION_CUSTOMERS_ENABLED=true
BASTION_S3_BUCKET=
BASTION_S3_REGION=us-east-1
# SMTP host allowlist is set by deployment; cannot be overridden from browser.
BASTION_SMTP_ALLOWED_HOSTS=
# Required in production: curated SHA256 password denylist, one hash per line, outside Git.
BASTION_PASSWORD_DENYLIST_FILE=

BASTION_SUPPLIERS_ENABLED=true

BASTION_PROCESSES_ENABLED=true

BASTION_QUOTES_ENABLED=true

# Optional local approved PNG assets, <=1 MiB and 2000x2000. No remote URLs.
BASTION_PDF_LOGO=
BASTION_PDF_STAMP=

# Local workflow/approval controls; does not activate delivery.
BASTION_WORKFLOW_ENABLED=true
