CRAWLER_DATA=/var/lib/bastion-crawler
SOURCE_URL=http://sicc.honducompras.gob.hn/HC/Procesos/BusquedaHistorico.aspx
REQUEST_DELAY=3
CONNECT_TIMEOUT=10
READ_TIMEOUT=90
HTTP_ATTEMPTS=3
MAX_PAGES=500
MAX_RUN_SECONDS=14400
MAX_RESPONSE_BYTES=10485760
S3_ENABLED=false
S3_BUCKET=castilloit-honducompras-crawler
AWS_DEFAULT_REGION=us-east-1
BLUEHOST_MODE=disabled
# api | ftps | disabled
BASTION_API_URL=https://REPLACE.example/api/internal/v1/crawler
BASTION_TOKEN=
BLUEHOST_FTP_HOST=
BLUEHOST_FTP_USER=
BLUEHOST_FTP_PASSWORD=
BLUEHOST_FTP_REMOTE_DIR=/private_csv/bastion_inbox
