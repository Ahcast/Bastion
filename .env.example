# Copy to .env for local development. Never put real secrets in this file or Git.
BASTION_LISTEN_ADDR=127.0.0.1:8080
BASTION_CORS_ALLOWED_ORIGIN=https://bastion.castilloit.net
# Empty for direct connections. With a local Caddy ingress only, use
# 127.0.0.1/32,::1/128 and keep the backend bound to loopback.
# Trust only actual proxies; never use a catch-all CIDR for client networks.
BASTION_TRUSTED_PROXY_CIDRS=
# Business modules allowed in this environment; empty keeps Core only.
# Comma-separated IDs: procesos,cotizaciones,clientes,proveedores,ordenes_compra,facturas,colaboracion,gastos. Then activate in Ajustes.
# To offer Procesos in Ajustes after its migration: procesos
BASTION_ALLOWED_MODULES=
# Server-side MIME detection for Colaboración. Requires file/libmagic installed.
BASTION_FILE_BIN=/usr/bin/file
# Local delivery from Scout on the same host. Explicit opt-in; no network token.
BASTION_SCOUT_IMPORT_ENABLED=false
BASTION_SCOUT_CSV_PATH=/var/lib/bastion-scout/maestro.csv
BASTION_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
# Base64 encoding of a random 32-byte key. In production inject a KMS-managed value.
BASTION_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

MYSQL_HOST=your-bluehost-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=bastion_dev
MYSQL_USER=bastion_runtime
MYSQL_PASSWORD=replace-with-runtime-secret
# Only needed by the migrate command; omit from the running server environment.
MYSQL_MIGRATOR_USER=bastion_migrator
MYSQL_MIGRATOR_PASSWORD=replace-with-migration-secret
MYSQL_TLS_CA=/run/secrets/mysql-ca.pem

# Private PDF generation/storage. Set on the backend only.
BASTION_DOCUMENTS_ENABLED=false
BASTION_TYPST_BIN=/usr/local/bin/typst
BASTION_AWS_CLI=/usr/local/bin/aws
BASTION_DOCUMENTS_BUCKET=
BASTION_DOCUMENTS_REGION=us-east-1
BASTION_DOCUMENTS_WORK_DIR=/var/lib/bastion/documents/work
BASTION_BRANDING_DIR=/var/lib/bastion/documents/branding

# Optional private Scout controller; disabled when empty.
BASTION_SCOUT_CONTROL_SOCKET=
