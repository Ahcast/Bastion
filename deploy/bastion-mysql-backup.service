[Unit]
Description=Bastion daily complete data backup
Requires=bastion-backup-control.service
After=bastion-backup-control.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=bastion
Group=bastion
ExecStart=/usr/bin/python3 /usr/local/libexec/bastion-backup/bastion_backup_controller.py --request backup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=7h
Restart=on-failure
RestartSec=15min
