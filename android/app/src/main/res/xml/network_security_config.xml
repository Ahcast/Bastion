<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- Android 7 predates ISRG Root X1. Add the verified public root ONLY for our API.
         Keep standard hostname, certificate-chain and validity verification. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.bastion.castilloit.net</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>
</network-security-config>
