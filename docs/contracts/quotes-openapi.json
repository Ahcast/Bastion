  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "unit",
          "quantity",
          "unit_price",
          "unit_cost",
          "discount_type",
          "discount",
          "tax"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit_price": {
            "type": "string"
          },
          "unit_cost": {
            "type": "string"
          },
          "discount_type": {
            "type": "string"
          },
          "discount": {
            "type": "string"
          },
          "tax": {
            "type": "string",
            "enum": [
              "isv15",
              "isv18",
              "exempt",
              "exonerated"
            ]
          }
        }
      },
      "Customer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rtn",
          "contact",
          "phone",
          "email",
          "address"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rtn": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "general_discount_type": {
            "type": "string",
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "private_notes": {
            "type": "string"
          },
          "author_contact": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "validity_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "required": [
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference",
          "reference",
          "date",
          "terms",
          "private_notes",
          "author_contact",
          "version",
          "customer",
          "currency",
          "validity_days"
        ]
      },
      "Calculate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "general_discount_type": {
            "type": "string",
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "required": [
          "version"
        ]
      },
      "FromProcess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "string",
            "enum": [
              "0"
            ]
          }
        },
        "required": [
          "date",
          "version"
        ]
      }
    },
    "securitySchemes": {
      "Session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    }
  },
  "security": [
    {
      "Session": []
    }
  ]
}
