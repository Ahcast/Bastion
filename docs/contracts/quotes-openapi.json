{
  "openapi": "3.0.3",
  "info": {
    "title": "Bastion Cotizaciones: unidad de borradores",
    "version": "0.1.0",
    "description": "Contrato limitado a esta unidad; PDF/envío/bulk/estados y conversiones OC/Factura pendientes. Salidas y cálculo canónico detallados en quotes.md."
  },
  "paths": {
    "/api/v1/quotes": {
      "get": {
        "summary": "Listar resúmenes autorizados",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Acceso denegado"
          },
          "404": {
            "description": "No visible"
          },
          "409": {
            "description": "Versión o intención conflictiva"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deleted",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ]
      },
      "post": {
        "summary": "Crear borrador",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Acceso denegado"
          },
          "404": {
            "description": "No visible"
          },
          "409": {
            "description": "Versión o intención conflictiva"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        }
      }
    },
