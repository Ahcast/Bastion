  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_number",
          "expense_date",
          "supplier",
          "category",
          "currency",
          "taxable_amount",
          "exempt_amount",
          "notes",
          "team_id",
          "version"
        ],
        "properties": {
          "invoice_number": {
            "type": "string"
          },
          "expense_date": {
            "type": "string",
            "format": "date"
          },
          "supplier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "product_purchase",
              "freight",
              "customs",
              "taxes",
              "transport",
              "travel",
              "software",
              "services",
              "advertising",
              "office",
              "other"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "taxable_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "exempt_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "notes": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "StateInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "CalculationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "taxable_amount",
          "exempt_amount"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "taxable_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "exempt_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          }
        }
      }
    }
