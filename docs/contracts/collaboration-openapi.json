  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bastion_dev_session"
      }
    },
    "schemas": {
      "ID": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "Version": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "FolderInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "company",
              "person"
            ]
