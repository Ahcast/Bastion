{
  "openapi": "3.1.0",
  "info": {
    "title": "Bastion Colaboración",
    "version": "0.1.0",
    "description": "Biblioteca privada Core.Files. Las rutas de comentarios, tareas e integraciones se añaden en sus unidades propietarias."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/collaboration": {
      "get": {
        "summary": "Listar archivos",
        "description": "Scopes empresa/persona y permisos Core se intersectan en SQL antes del conteo; deleted=true consulta la papelera.",
        "operationId": "get_listar_archivos",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Missing"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "company",
                "person"
              ]
            }
          },
          {
            "name": "person_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(|[1-9][0-9]*)$"
            }
          },
          {
            "name": "folder_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(root|[1-9][0-9]*)$"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "deleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ]
      },
      "post": {
        "summary": "Vincular documento Core",
        "description": "Vincula un archivo finalizado/quarantine o disponible y no generado. Enlace Core.Files y fila son atómicos; el byte no se copia. Requiere reautenticación reciente.",
        "operationId": "post_vincular_documento_core",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Missing"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryInput"
              }
            }
          }
        }
      }
    },
