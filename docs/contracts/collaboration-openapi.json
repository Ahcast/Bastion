{
  "openapi": "3.1.0",
  "info": {
    "title": "Bastion Colaboración",
    "version": "0.1.0",
    "description": "Biblioteca privada, conversación, tareas propias, vínculos documentales y bandeja de aprobaciones Workflow de solo lectura. Cada acceso revalida permisos actuales del recurso propietario."
  },
  "security": [{"session": []}],
  "paths": {
    "/api/v1/collaboration": {
      "get": {"summary": "Listar archivos autorizados", "responses": {"200": {"description": "Página autorizada"}}},
      "post": {"summary": "Vincular documento Core.Files", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EntryInput"}}}}, "responses": {"200": {"description": "Archivo vinculado"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/folders": {
      "get": {"summary": "Listar carpetas autorizadas", "responses": {"200": {"description": "Carpetas"}}},
      "post": {"summary": "Crear carpeta", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Carpeta creada"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/teams": {
      "get": {"summary": "Listar equipos propios", "responses": {"200": {"description": "Equipos"}}}
    },
    "/api/v1/collaboration/folders/{id}": {
      "patch": {"summary": "Renombrar carpeta", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Carpeta actualizada"}, "409": {"$ref": "#/components/responses/Conflict"}}},
      "delete": {"summary": "Enviar carpeta vacía a papelera", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Carpeta eliminada lógicamente"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/folders/{id}/restore": {
      "post": {"summary": "Restaurar carpeta", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Carpeta restaurada"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/tasks": {
      "get": {
        "summary": "Listar Mi trabajo, Hoy o Vencidas",
        "parameters": [
          {"name": "view", "in": "query", "schema": {"type": "string", "enum": ["mine", "today", "overdue"]}},
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["open", "in_progress", "done", "cancelled"]}},
          {"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}
        ],
        "responses": {"200": {"description": "Tareas autorizadas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskPage"}}}}}
      },
      "post": {
        "summary": "Crear tarea de Colaboración",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskInput"}}}},
        "responses": {"200": {"description": "Tarea creada"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Invalid"}}
      }
    },
    "/api/v1/collaboration/task-assignees": {
      "get": {
        "summary": "Listar asignables con acceso vigente al recurso",
        "parameters": [
          {"name": "resource_type", "in": "query", "schema": {"type": "string"}},
          {"name": "resource_id", "in": "query", "schema": {"type": "string"}},
          {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 100}}
        ],
        "responses": {"200": {"description": "Usuarios asignables"}, "404": {"$ref": "#/components/responses/Missing"}}
      }
    },
    "/api/v1/collaboration/tasks/{id}": {
      "patch": {
        "summary": "Editar asignación, título, nota o vencimiento",
        "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskUpdate"}}}},
        "responses": {"200": {"description": "Tarea actualizada"}, "409": {"$ref": "#/components/responses/Conflict"}}
      }
    },
    "/api/v1/collaboration/tasks/{id}/status": {
      "post": {
        "summary": "Cambiar estado por el asignado",
        "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskStatusInput"}}}},
        "responses": {"200": {"description": "Estado actualizado"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}
      }
    },
    "/api/v1/collaboration/tasks/{id}/reopen": {
      "post": {
        "summary": "Reabrir explícitamente tarea cerrada",
        "description": "Sólo el creador, con permiso y reautenticación reciente.",
        "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VersionInput"}}}},
        "responses": {"200": {"description": "Tarea reabierta"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}
      }
    },
    "/api/v1/collaboration/approvals": {
      "get": {
        "summary": "Bandeja Workflow pendiente de solo lectura",
        "description": "Sólo devuelve aprobaciones donde el actor conserva view y decision permission; no ofrece endpoint de decisión.",
        "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}],
        "responses": {"200": {"description": "Aprobaciones pendientes autorizadas", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApprovalPage"}}}}, "503": {"$ref": "#/components/responses/Unavailable"}}
      }
    },
    "/api/v1/collaboration/{id}/links": {
      "get": {
        "summary": "Listar vínculos documentales autorizados",
        "description": "Revalida el recurso propietario y omite vínculos cuyo acceso o estado ya no sea válido.",
        "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {"200": {"description": "Vínculos", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Link"}}}}}}}}
      },
      "put": {
        "summary": "Reemplazar vínculos documentales",
        "description": "No copia bytes ni modifica el recurso. Exige versión vigente de la entrada y de cada recurso, permiso colaboracion.link y reautenticación.",
        "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SetLinksInput"}}}},
        "responses": {"200": {"description": "Vínculos actualizados"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}
      }
    },
    "/api/v1/collaboration/resources/{resource_type}/{resource_id}/comments": {
      "get": {"summary": "Listar comentarios con acceso vigente", "parameters": [{"$ref": "#/components/parameters/ResourceType"}, {"$ref": "#/components/parameters/ResourceID"}, {"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}], "responses": {"200": {"description": "Comentarios"}, "404": {"$ref": "#/components/responses/Missing"}}},
      "post": {"summary": "Agregar comentario y menciones", "parameters": [{"$ref": "#/components/parameters/ResourceType"}, {"$ref": "#/components/parameters/ResourceID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Comentario creado"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Invalid"}}}
    },
    "/api/v1/collaboration/resources/{resource_type}/{resource_id}/activity": {
      "get": {"summary": "Consultar actividad mínima", "parameters": [{"$ref": "#/components/parameters/ResourceType"}, {"$ref": "#/components/parameters/ResourceID"}, {"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}], "responses": {"200": {"description": "Actividad"}, "404": {"$ref": "#/components/responses/Missing"}}}
    },
    "/api/v1/collaboration/resources/{resource_type}/{resource_id}/mentionable-users": {
      "get": {"summary": "Buscar personas con acceso actual", "parameters": [{"$ref": "#/components/parameters/ResourceType"}, {"$ref": "#/components/parameters/ResourceID"}, {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 100}}], "responses": {"200": {"description": "Usuarios mencionables"}, "404": {"$ref": "#/components/responses/Missing"}}}
    },
    "/api/v1/collaboration/comments/{id}": {
      "delete": {"summary": "Eliminar lógicamente comentario", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Comentario eliminado"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/notifications": {
      "get": {"summary": "Listar notificaciones propias", "parameters": [{"name": "after_id", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}], "responses": {"200": {"description": "Notificaciones autorizadas"}}}
    },
    "/api/v1/collaboration/notifications/{id}/read": {
      "post": {"summary": "Marcar notificación como leída", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Notificación leída"}, "404": {"$ref": "#/components/responses/Missing"}}}
    },
    "/api/v1/collaboration/{id}": {
      "get": {"summary": "Obtener archivo", "parameters": [{"$ref": "#/components/parameters/ID"}], "responses": {"200": {"description": "Ficha autorizada"}, "404": {"$ref": "#/components/responses/Missing"}}},
      "patch": {"summary": "Editar ficha del archivo", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Ficha actualizada"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}},
      "delete": {"summary": "Enviar archivo a papelera", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Archivo en papelera"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/{id}/restore": {
      "post": {"summary": "Restaurar archivo", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Archivo restaurado"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/api/v1/collaboration/{id}/versions": {
      "get": {"summary": "Listar versiones Core.Files", "parameters": [{"$ref": "#/components/parameters/ID"}], "responses": {"200": {"description": "Versiones"}, "404": {"$ref": "#/components/responses/Missing"}}}
    },
    "/api/v1/collaboration/{id}/preview": {
      "get": {"summary": "Obtener preview temporal", "parameters": [{"$ref": "#/components/parameters/ID"}, {"name": "file_version", "in": "query", "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "URL temporal autorizada"}, "404": {"$ref": "#/components/responses/Missing"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/api/v1/collaboration/{id}/download": {
      "get": {"summary": "Obtener descarga temporal", "parameters": [{"$ref": "#/components/parameters/ID"}, {"name": "file_version", "in": "query", "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "URL temporal autorizada"}, "404": {"$ref": "#/components/responses/Missing"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    }
  },
  "components": {
    "securitySchemes": {"session": {"type": "apiKey", "in": "cookie", "name": "bastion_dev_session"}},
    "parameters": {
      "ID": {"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/PositiveID"}},
      "ResourceType": {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string", "enum": ["collaboration", "processes", "quotes", "purchase_orders", "invoices"]}},
      "ResourceID": {"name": "resource_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/PositiveID"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 100}},
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 1}},
      "PerPage": {"name": "per_page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}
    },
    "schemas": {
      "PositiveID": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
      "Version": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
      "VersionInput": {"type": "object", "additionalProperties": false, "properties": {"version": {"$ref": "#/components/schemas/Version"}}, "required": ["version"]},
      "EntryInput": {"type": "object", "additionalProperties": false, "properties": {"document_id": {"$ref": "#/components/schemas/PositiveID"}, "document_version": {"$ref": "#/components/schemas/Version"}, "scope": {"type": "string", "enum": ["company", "person"]}, "person_id": {"type": "string"}, "folder_id": {"type": "string"}, "title": {"type": "string", "maxLength": 180}, "notes": {"type": "string", "maxLength": 4000}}, "required": ["document_id", "document_version", "scope", "person_id", "folder_id", "title", "notes"]},
      "TaskInput": {"type": "object", "additionalProperties": false, "properties": {"assignee_id": {"$ref": "#/components/schemas/PositiveID"}, "resource_type": {"type": "string"}, "resource_id": {"type": "string"}, "title": {"type": "string", "minLength": 1, "maxLength": 180}, "note": {"type": "string", "maxLength": 4000}, "due_date": {"type": "string", "format": "date"}}, "required": ["assignee_id", "resource_type", "resource_id", "title", "note", "due_date"]},
      "TaskUpdate": {"type": "object", "additionalProperties": false, "properties": {"version": {"$ref": "#/components/schemas/Version"}, "assignee_id": {"$ref": "#/components/schemas/PositiveID"}, "title": {"type": "string", "minLength": 1, "maxLength": 180}, "note": {"type": "string", "maxLength": 4000}, "due_date": {"type": "string", "format": "date"}}, "required": ["version", "assignee_id", "title", "note", "due_date"]},
      "TaskStatusInput": {"type": "object", "additionalProperties": false, "properties": {"version": {"$ref": "#/components/schemas/Version"}, "status": {"type": "string", "enum": ["open", "in_progress", "done", "cancelled"]}}, "required": ["version", "status"]},
      "Task": {"type": "object", "properties": {"id": {"$ref": "#/components/schemas/PositiveID"}, "creator_id": {"$ref": "#/components/schemas/PositiveID"}, "assignee_id": {"$ref": "#/components/schemas/PositiveID"}, "assignee_name": {"type": "string"}, "resource_type": {"type": "string"}, "resource_id": {"type": "string"}, "resource_label": {"type": "string"}, "title": {"type": "string"}, "note": {"type": "string"}, "due_date": {"type": "string", "format": "date"}, "status": {"type": "string", "enum": ["open", "in_progress", "done", "cancelled"]}, "version": {"$ref": "#/components/schemas/Version"}}},
      "TaskPage": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Task"}}, "total": {"type": "integer"}, "page": {"type": "integer"}, "per_page": {"type": "integer"}}, "required": ["data", "total", "page", "per_page"]},
      "LinkInput": {"type": "object", "additionalProperties": false, "properties": {"resource_type": {"type": "string", "enum": ["processes", "quotes", "purchase_orders", "invoices"]}, "resource_id": {"$ref": "#/components/schemas/PositiveID"}, "resource_version": {"$ref": "#/components/schemas/Version"}}, "required": ["resource_type", "resource_id", "resource_version"]},
      "SetLinksInput": {"type": "object", "additionalProperties": false, "properties": {"version": {"$ref": "#/components/schemas/Version"}, "links": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/LinkInput"}}}, "required": ["version", "links"]},
      "Link": {"type": "object", "properties": {"resource_type": {"type": "string"}, "resource_id": {"$ref": "#/components/schemas/PositiveID"}, "resource_version": {"$ref": "#/components/schemas/Version"}, "current_version": {"$ref": "#/components/schemas/Version"}, "label": {"type": "string"}, "current_label": {"type": "string"}, "stale": {"type": "boolean"}, "linked_by": {"$ref": "#/components/schemas/PositiveID"}, "linked_at": {"type": "string", "format": "date-time"}}},
      "ApprovalPage": {"type": "object", "properties": {"data": {"type": "array", "items": {"type": "object"}}, "total": {"type": "integer"}, "page": {"type": "integer"}, "per_page": {"type": "integer"}}, "required": ["data", "total", "page", "per_page"]},
      "Error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}}, "required": ["code", "message", "request_id"]}
    },
    "responses": {
      "Forbidden": {"description": "Permiso o reautenticación requerida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Missing": {"description": "Registro ajeno, terminal o inexistente", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "Versión, replay o transición incompatible", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Invalid": {"description": "DTO o transición inválidos", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unavailable": {"description": "Integración o almacenamiento no disponible", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
