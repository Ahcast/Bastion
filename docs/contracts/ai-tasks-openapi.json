  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    },
    "schemas": {
      "CreateInput": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0"
          },
          "process_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "input_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "skill_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$"
          }
        },
        "required": [
          "schema_version",
          "process_id",
          "input_version",
          "skill_version"
        ],
        "additionalProperties": false
      },
      "ClaimInput": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "schema_version",
          "limit"
        ],
        "additionalProperties": false
      },
      "ExecutionInput": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0"
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "input_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "skill_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$"
          },
          "lease_token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
