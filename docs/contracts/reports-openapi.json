  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    },
    "schemas": {
      "Filter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date_from": {
            "type": "string"
          },
          "date_to": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      },
      "Total": {
        "type": "object",
        "required": [
          "currency",
          "count",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?[0-9]+\\.[0-9]{2}$"
            }
          }
        }
      },
      "invoicesRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "invoice_number",
          "customer",
          "invoice_date",
          "due_date",
          "currency",
          "status",
          "total",
          "paid_total",
          "balance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "invoice_date": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "paid_total": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          }
        }
      },
      "invoicesPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report",
          "filters",
          "data",
          "total",
          "page",
          "per_page",
          "totals"
        ],
        "properties": {
          "report": {
            "const": "invoices"
          },
          "filters": {
            "$ref": "#/components/schemas/Filter"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/invoicesRow"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "totals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Total"
            }
          }
        }
      },
      "ordersRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order_number",
          "customer",
          "destination",
          "order_date",
          "currency",
          "status",
          "subtotal",
          "tax_amount",
          "total",
          "products_investment",
          "additional_expenses",
          "investment_total",
          "profit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order_number": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "order_date": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subtotal": {
            "type": "string"
          },
          "tax_amount": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "products_investment": {
            "type": "string"
          },
          "additional_expenses": {
            "type": "string"
          },
          "investment_total": {
            "type": "string"
          },
          "profit": {
            "type": "string"
          }
        }
      },
      "ordersPage": {
