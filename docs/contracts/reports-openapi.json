      },
      "Home": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filters",
          "reports"
        ],
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/Filter"
          },
          "reports": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "invoices": {
                "type": "array",
