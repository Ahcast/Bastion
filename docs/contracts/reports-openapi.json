          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "received",
                "confirmed",
                "purchasing",
                "in_transit",
                "goods_received",
                "preparing_delivery",
                "delivered",
                "invoiced",
                "closed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte autorizado",
            "content": {
              "application/json": {
