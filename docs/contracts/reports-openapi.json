            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "totals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Total"
            }
          }
        }
      },
      "expensesRow": {
