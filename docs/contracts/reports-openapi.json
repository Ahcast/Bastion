{
  "openapi": "3.1.0",
  "info": {
    "title": "Bastion Reportes",
    "version": "0.1.0"
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/reports/invoices": {
      "get": {
        "summary": "Reporte invoices",
        "description": "reportes.view y permiso fuente; scopes intersectados; montos exactos, totales SQL y página del mismo snapshot.",
        "parameters": [
          {
            "name": "date_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "HNL",
                "USD"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "issued"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reporte autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invoicesPage"
                }
              }
            }
          },
          "401": {
            "description": "Sesión/MFA requeridos"
          },
          "403": {
            "description": "Permiso denegado"
          },
          "404": {
            "description": "Fuente deshabilitada"
          },
          "422": {
            "description": "Filtro inválido"
          },
          "500": {
            "description": "Error interno sanitizado"
          }
        }
      }
    },
    "/api/v1/reports/orders": {
