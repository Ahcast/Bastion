          },
          "403": {
            "description": "Permiso denegado"
          },
          "404": {
            "description": "Fuente deshabilitada"
          },
          "422": {
            "description": "Filtro inválido"
          },
          "500": {
            "description": "Error interno sanitizado"
          }
        }
      }
    },
