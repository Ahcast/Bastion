{
  "openapi": "3.1.0",
  "info": {
    "title": "Bastion Facturas: borradores, configuración, emisión y pagos",
    "version": "0.4.0"
  },
  "paths": {
    "/api/v1/invoices": {
      "get": {
        "description": "Listado paginado por scopes facturas.view, filtros draft/issued, número fiscal nullable y monedas separadas.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "description": "Crear Borrador humano, scopes facturas.create/view, CSRF, versión 0. Sin número fiscal/SAR ni pago real. TX/evidencia/idempotencia.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/invoices/{id}": {
      "get": {
        "description": "Ficha autorizada con ítems/calculo/snapshot histórico.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      },
      "patch": {
        "description": "Editar únicamente draft con versión actual, facturas.update/view y CSRF. Cambio de equipo exige scope all y reauth.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/invoices/calculate": {
      "post": {
        "description": "Vista previa canónica privada, facturas.view y CSRF; sin efecto comercial.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculationInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/fiscal-settings": {
      "get": {
        "description": "Configuración singleton y contador consistente; fiscal.read global. 404 si no existe. No emite ni valida autorización legal.",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configuración autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiscalSettings"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        }
      },
      "put": {
        "description": "Humano fiscal.manage/read global, reauth, CSRF e idempotencia. Contador inicial atómico; editar no adelanta ni retrocede. Protege formato consumido.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FiscalSettingsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        }
      }
    },
    "/api/v1/invoices/{id}/emission-context": {
      "get": {
        "description": "Revisión humana autorizada view/emit del registro. Validación de borrador, configuración, moneda, vigencia, cálculo y empresa. Número estimado sin reserva.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmissionContext"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          },
          "503": {
            "description": "Empresa no configurada"
          }
        }
      }
    },
    "/api/v1/invoices/{id}/emit": {
      "post": {
        "description": "Humano view/emit, reauth, CSRF, versiones e idempotencia. Número, empresa/SAR/vencimiento/estado y contador/evidencia atómicos; no pagos, PDF ni acreditación fiscal productiva.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmissionResult"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          },
          "503": {
            "description": "Empresa no configurada"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmitInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/{id}/payments": {
      "get": {
        "description": "Ledger paginado incluido anulado, versión/proyección de factura consistentes y autorización view por registro. No recibo hasta unidad 6.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "data/total/page/per_page y proyección/version actual"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        }
      },
      "post": {
        "description": "Humano view/payment por registro, reauth/CSRF/idempotencia/version. Solo issued, moneda exacta, importe positivo sin sobrepago, fecha invoice_date..hoy Honduras; ledger/proyección/audit/event atómicos.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/{id}/payments/{payment}/void": {
      "post": {
        "description": "Humano view/payment.void, reauth/CSRF/idempotencia/versiones. Conserva datos, marca anulación y recalcula excluyendo fila en la misma TX; no borrar ni editar importe.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidPaymentInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    },
    "schemas": {
      "CalculationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference",
          "additional_expenses"
        ],
        "properties": {
          "currency": {
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "unit",
                "quantity",
                "unit_price",
                "unit_cost",
                "discount_type",
                "discount",
                "tax"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "string"
                },
                "discount": {
                  "type": "string"
                },
                "discount_type": {
                  "enum": [
                    "amount",
                    "percent"
                  ]
                },
                "tax": {
                  "enum": [
                    "isv15",
                    "isv18",
                    "exempt",
                    "exonerated"
                  ]
                }
              }
            }
          },
          "general_discount_type": {
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          },
          "additional_expenses": {
            "type": "string"
          }
        }
      },
      "DraftInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference",
          "additional_expenses",
          "customer",
          "invoice_date",
          "payment_term_type",
          "credit_days",
          "public_notes",
          "team_id",
          "version"
        ],
        "properties": {
          "currency": {
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "unit",
                "quantity",
                "unit_price",
                "unit_cost",
                "discount_type",
                "discount",
                "tax"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "string"
                },
                "discount": {
                  "type": "string"
                },
                "discount_type": {
                  "enum": [
                    "amount",
                    "percent"
                  ]
                },
                "tax": {
                  "enum": [
                    "isv15",
                    "isv18",
                    "exempt",
                    "exonerated"
                  ]
                }
              }
            }
          },
          "general_discount_type": {
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          },
          "additional_expenses": {
            "type": "string"
          },
          "customer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "rtn",
              "contact",
              "phone",
              "email",
              "address"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "rtn": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "payment_term_type": {
            "enum": [
              "contado",
              "credito"
            ]
          },
          "credit_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535
          },
          "public_notes": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "FiscalAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cai",
          "prefix",
          "number_width",
          "range_start",
          "range_end",
          "valid_from",
          "valid_until",
          "currency",
          "enabled"
        ],
        "properties": {
          "cai": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "prefix": {
            "type": "string",
            "maxLength": 60
          },
          "number_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "range_start": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "range_end": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "description": "Valores explícitos de configuración; límites técnicos, sin acreditación legal SAR."
      },
      "FiscalSettingsInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "value",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "value": {
            "$ref": "#/components/schemas/FiscalAuthorization"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "FiscalSettings": {
        "type": "object",
        "required": [
          "version",
          "value",
          "next_value"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/FiscalAuthorization"
          },
          "next_value": {
            "type": "string"
          }
        }
      },
      "EmitInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "fiscal_version",
          "company_version",
          "reason"
        ],
        "properties": {
