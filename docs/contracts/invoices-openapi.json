{
  "openapi": "3.1.0",
  "info": {
    "title": "Bastion Facturas — Borradores",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/invoices": {
      "get": {
        "description": "Listado paginado, búsqueda literal y scopes facturas.view. Solo draft en esta unidad.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "description": "Crear Borrador humano, scopes facturas.create/view, CSRF, versión 0. Sin número fiscal/SAR ni pago real. TX/evidencia/idempotencia.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/invoices/{id}": {
      "get": {
        "description": "Ficha autorizada con ítems/calculo/snapshot histórico.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      },
      "patch": {
        "description": "Editar únicamente draft con versión actual, facturas.update/view y CSRF. Cambio de equipo exige scope all y reauth.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/invoices/calculate": {
      "post": {
        "description": "Vista previa canónica privada, facturas.view y CSRF; sin efecto comercial.",
        "responses": {
          "200": {
            "description": "Resultado autorizado"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Permiso/CSRF/reauth insuficiente"
          },
          "404": {
            "description": "Recurso fuera de scope"
          },
          "409": {
            "description": "Versión/intención/estado conflictivo"
          },
          "422": {
            "description": "DTO/formatos inválidos"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculationInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bastion_session"
      }
    },
    "schemas": {
      "CalculationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference",
          "additional_expenses"
        ],
        "properties": {
          "currency": {
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "unit",
                "quantity",
                "unit_price",
                "unit_cost",
                "discount_type",
                "discount",
                "tax"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "string"
                },
                "discount": {
                  "type": "string"
                },
                "discount_type": {
                  "enum": [
                    "amount",
                    "percent"
                  ]
                },
                "tax": {
                  "enum": [
                    "isv15",
                    "isv18",
                    "exempt",
                    "exonerated"
                  ]
                }
              }
            }
          },
          "general_discount_type": {
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          },
          "additional_expenses": {
            "type": "string"
          }
        }
      },
      "DraftInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "items",
          "general_discount_type",
          "general_discount",
          "exoneration_reference",
          "additional_expenses",
          "customer",
          "invoice_date",
          "payment_term_type",
          "credit_days",
          "public_notes",
          "team_id",
          "version"
        ],
        "properties": {
          "currency": {
            "enum": [
              "HNL",
              "USD"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "unit",
                "quantity",
                "unit_price",
                "unit_cost",
                "discount_type",
                "discount",
                "tax"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "string"
                },
                "discount": {
                  "type": "string"
                },
                "discount_type": {
                  "enum": [
                    "amount",
                    "percent"
                  ]
                },
                "tax": {
                  "enum": [
                    "isv15",
                    "isv18",
                    "exempt",
                    "exonerated"
                  ]
                }
              }
            }
          },
          "general_discount_type": {
            "enum": [
              "amount",
              "percent"
            ]
          },
          "general_discount": {
            "type": "string"
          },
          "exoneration_reference": {
            "type": "string"
          },
          "additional_expenses": {
            "type": "string"
          },
          "customer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "rtn",
              "contact",
              "phone",
              "email",
              "address"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "rtn": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "payment_term_type": {
            "enum": [
              "contado",
              "credito"
            ]
          },
          "credit_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535
          },
          "public_notes": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    }
  }
}
