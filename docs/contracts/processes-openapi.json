          "404": {
            "description": "Entidad no accesible"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Solicitud inválida o límite de exportación"
          },
          "429": {
            "description": "Límite de concurrencia"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
